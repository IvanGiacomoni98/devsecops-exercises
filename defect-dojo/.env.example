# Copy this file to .env and fill in the secrets:
#   cp .env.example .env

# Pull from Docker Hub instead of the DefectDojo registry, which logs every pull
DD_IMAGE_REGISTRY=docker.io

# Pin version (django & nginx versions must match)
DJANGO_VERSION=3.4.303
NGINX_VERSION=3.4.303

# Secret Key (64 chars)
# openssl rand -base64 48
DD_SECRET_KEY=
# AES (32 chars, no padding)
# openssl rand -base64 24
DD_CREDENTIAL_AES_256_KEY=

# Password DB (32 hex chars)
# openssl rand -hex 16
DD_DATABASE_PASSWORD=
DD_DATABASE_URL=postgresql://defectdojo:${DD_DATABASE_PASSWORD}@postgres:5432/defectdojo

# provide the list of hosts that will interact with defect-dojo (most likely all tools that will upload content + DD domain for web access)
DD_ALLOWED_HOSTS=*
DD_PORT=9080
DD_TLS_PORT=8443
